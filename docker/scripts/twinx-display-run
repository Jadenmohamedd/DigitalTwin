#!/usr/bin/env bash
set -euo pipefail

for ((attempt = 0; attempt < 60; attempt++)); do
    if xdpyinfo -display "${DISPLAY:?DISPLAY must be set}" > /dev/null 2>&1; then
        exec "$@"
    fi
    sleep 0.5
done

echo "ERROR: X display ${DISPLAY} did not become ready within 30 seconds." >&2
exit 1
