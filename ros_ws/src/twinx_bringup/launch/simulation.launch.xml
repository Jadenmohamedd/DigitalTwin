<?xml version="1.0"?>
<launch>
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r -s --headless-rendering -v 3 $(find-pkg-share twinx_bringup)/worlds/lab.sdf" />
    <arg name="on_exit_shutdown" value="true" />
  </include>
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="simulation_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share twinx_bringup)/config/bridge.yaml" />
    <param name="use_sim_time" value="true" />
  </node>
  <include file="$(find-pkg-share twinx_bringup)/launch/go2.launch.py" />
</launch>
