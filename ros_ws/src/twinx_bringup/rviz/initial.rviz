Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Color: 140; 150; 170
      Alpha: 0.5
  Global Options:
    Background Color: 32; 38; 50
    Fixed Frame: world
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 0.8
      Yaw: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1100
  Height: 720
